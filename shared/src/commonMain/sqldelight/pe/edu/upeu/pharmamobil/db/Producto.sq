CREATE TABLE producto (
    id INTEGER NOT NULL PRIMARY KEY,
    nombre TEXT NOT NULL,
    precio REAL NOT NULL,
    stock INTEGER NOT NULL,
    pendiente INTEGER NOT NULL DEFAULT 0,
    activo INTEGER NOT NULL DEFAULT 1,
    intentos INTEGER NOT NULL DEFAULT 0,
    ultimoError TEXT
);

CREATE TABLE sync_meta (
    clave TEXT NOT NULL PRIMARY KEY,
    valor INTEGER NOT NULL
);

listarTodos:
SELECT * FROM producto ORDER BY nombre ASC;
listarPendientes:
SELECT * FROM producto WHERE pendiente = 1 ORDER BY id;
insertar:
INSERT OR REPLACE INTO producto(id, nombre, precio, stock, pendiente, activo, intentos, ultimoError)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);
borrarSincronizados:
DELETE FROM producto WHERE pendiente = 0;
siguienteIdLocal:
SELECT COALESCE(MIN(id), 0) FROM producto;
eliminar:
DELETE FROM producto WHERE id = ?;
obtener:
SELECT * FROM producto WHERE id = ?;

-- Sesión 13: cola de envío con intentos y último error
pendientesPorEnviar:
SELECT * FROM producto WHERE pendiente = 1 AND intentos < :maxIntentos
ORDER BY id;

listarFallidas:
SELECT * FROM producto WHERE pendiente = 1 AND intentos >= :maxIntentos
ORDER BY id;

contarPendientes:
SELECT COUNT(*) FROM producto WHERE pendiente = 1 AND intentos < :maxIntentos;

contarFallidas:
SELECT COUNT(*) FROM producto WHERE pendiente = 1 AND intentos >= :maxIntentos;

sumarIntento:
UPDATE producto SET intentos = intentos + 1, ultimoError = ? WHERE id = ?;

marcarFallida:
UPDATE producto SET intentos = :maxIntentos, ultimoError = :motivo WHERE id = :id;

reintentarFallidas:
UPDATE producto SET intentos = 0, ultimoError = NULL
WHERE pendiente = 1 AND intentos >= :maxIntentos;

guardarMeta:
INSERT OR REPLACE INTO sync_meta(clave, valor) VALUES (?, ?);

leerMeta:
SELECT valor FROM sync_meta WHERE clave = ?;

-- Sesión 14: el cierre de sesión deja el equipo limpio para otro usuario (hueco 7)
borrarTodo:
DELETE FROM producto;

borrarMeta:
DELETE FROM sync_meta;
