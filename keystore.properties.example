# Sesión 14 · Copia este archivo como keystore.properties en la RAÍZ del proyecto
# y reemplaza los valores. keystore.properties está en .gitignore: NUNCA se sube a Git.
# La ruta apunta a un archivo FUERA del repositorio.
# Windows: usa barras normales, por ejemplo C:/Users/juan/claves/equipo2.jks
storeFile=/ruta/fuera/del/repositorio/equipo2.jks
storePassword=********
keyAlias=equipo2
keyPassword=********
